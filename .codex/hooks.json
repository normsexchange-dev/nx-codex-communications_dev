{
  "description": "Managed usage lifecycle capture; standard 2026.08.31.1 from normsexchange-dev/ai-agent-control@99d5893a6a2afcd5611cd1609f1fda1539e509e2 (a7151ac300ef037c9e6ed55ba10a459d657d5862512fd16540d91e966fb92ce0).",
  "hooks": {
