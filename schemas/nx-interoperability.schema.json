{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/normsexchange-dev/nx-codex-communications_dev/communications-v0.8.0/schemas/nx-interoperability.schema.json",
  "title": "NX reserved-interface negotiation and hashes",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "protocol_id", "current", "supported", "preferred", "deprecated", "unsupported", "receiver_selection", "interfaces", "hashes"],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/normsexchange-dev/nx-codex-communications_dev/communications-v0.8.0/schemas/nx-interoperability.schema.json"},
    "schema_version": {"const": "1.0.0"}, "protocol_id": {"const": "nx-sovereign-interoperability"}, "current": {"const": "0.5.0"},
    "supported": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}},
    "preferred": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "deprecated": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}},
    "unsupported": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}},
    "receiver_selection": {"const": "highest_common_preferred_then_highest_common_supported"},
    "interfaces": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["nx.capabilities", "nx.environment", "nx.genesis", "nx.interoperability", "nx.lineage", "nx.provenance"]}},
    "hashes": {"type": "object", "additionalProperties": false, "required": ["environment.json", "genesis.json", "lineage.json", "capabilities.json", "provenance.json"], "properties": {
      "environment.json": {"$ref": "#/$defs/digest"}, "genesis.json": {"$ref": "#/$defs/digest"}, "lineage.json": {"$ref": "#/$defs/digest"}, "capabilities.json": {"$ref": "#/$defs/digest"}, "provenance.json": {"$ref": "#/$defs/digest"}
    }}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
