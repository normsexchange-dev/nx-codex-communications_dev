{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/normsexchange-dev/nx-codex-communications_dev/communications-v0.3.0/schemas/mission.schema.json",
  "title": "Norms Exchange permanent mission",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "mission_id", "mission_version", "immutability", "business_purpose", "marketplace_modes", "market_corridor", "equipment_scope", "norms_services", "evidence_rules", "prohibited_actions", "authority_rule"],
  "properties": {
    "$schema": {"const": "../schemas/mission.schema.json"},
    "mission_id": {"const": "norms-exchange-marketplace"},
    "mission_version": {"const": "1.0.0"},
    "immutability": {"const": "permanent"},
    "business_purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
    "marketplace_modes": {"const": ["WTS", "WTB"]},
    "market_corridor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supply_origin", "destination_market"],
      "properties": {
        "supply_origin": {"const": "Los Angeles and the United States"},
        "destination_market": {"const": "Vietnam"}
      }
    },
    "equipment_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "norms_services": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "evidence_rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 250}},
    "prohibited_actions": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"}},
    "authority_rule": {"type": "string", "minLength": 1, "maxLength": 500}
  }
}
