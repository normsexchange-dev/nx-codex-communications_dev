{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/normsexchange-dev/nx-codex-communications_dev/communications-v0.8.0/schemas/nx-genesis.schema.json",
  "title": "NX genesis receipt and sovereignty transfer",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "genesis_type", "canonical_release", "materializer", "destination", "materialized_at", "genesis_commit", "initial_core_digest", "human_principal", "sovereignty_transfer"],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/normsexchange-dev/nx-codex-communications_dev/communications-v0.8.0/schemas/nx-genesis.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "genesis_type": {"enum": ["fresh", "historical_adoption", "descendant"]},
    "canonical_release": {"type": "object", "additionalProperties": false, "required": ["repository", "tag", "tag_object", "target_commit", "source_digest"], "properties": {
      "repository": {"const": "normsexchange-dev/nx-codex-communications_dev"}, "tag": {"const": "communications-v0.8.0"},
      "tag_object": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "target_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
      "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }},
    "materializer": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "nx-sovereign-genesis"}, "version": {"const": "0.6.0"}}},
    "destination": {"type": "object", "additionalProperties": false, "required": ["owner", "repository", "environment_id", "runtime"], "properties": {
      "owner": {"type": "string", "minLength": 1}, "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
      "environment_id": {"type": "string", "minLength": 2}, "runtime": {"type": "string", "minLength": 1}
    }},
    "materialized_at": {"type": "string", "format": "date-time"},
    "genesis_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "initial_core_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "human_principal": {"type": "string", "minLength": 1},
    "sovereignty_transfer": {"type": "object", "additionalProperties": false, "required": ["state", "recipient", "effective_at"], "properties": {
      "state": {"const": "transferred"}, "recipient": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "effective_at": {"type": "string", "format": "date-time"}
    }}
  }
}
