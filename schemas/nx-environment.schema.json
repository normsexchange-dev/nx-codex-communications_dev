{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/normsexchange-dev/nx-codex-communications_dev/communications-v0.8.0/schemas/nx-environment.schema.json",
  "title": "NX sovereign environment identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "environment_id", "namespace_owner", "repository", "environment_type", "runtime", "human_principal", "created_at"],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/normsexchange-dev/nx-codex-communications_dev/communications-v0.8.0/schemas/nx-environment.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "environment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,127}$"},
    "namespace_owner": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "environment_type": {"const": "sovereign"},
    "runtime": {"type": "string", "minLength": 1, "maxLength": 128},
    "human_principal": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
